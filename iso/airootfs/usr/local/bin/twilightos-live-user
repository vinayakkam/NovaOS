#!/bin/bash
# Creates the passwordless "twilight" live user (home populated from /etc/skel)
# before SDDM autologs it in. The installer must disable this service.
set -euo pipefail

LIVE_USER=twilight

if ! id "$LIVE_USER" &>/dev/null; then
    useradd -m -G wheel -s /bin/bash -c "TwilightOS Live" "$LIVE_USER"
    passwd -d "$LIVE_USER" >/dev/null
fi

home=/home/$LIVE_USER
cfg=$home/.config
install -d -o "$LIVE_USER" -g "$LIVE_USER" "$cfg"

# Live-session-only tweaks (not in /etc/skel, so installed systems keep sane defaults)
cat > "$cfg/kscreenlockerrc" <<'EOF'
[Daemon]
Autolock=false
LockOnResume=false
EOF
cat > "$cfg/baloofilerc" <<'EOF'
[Basic Settings]
Indexing-Enabled=false
EOF
# No password wallet in the live session (saves ksecretd, ~50 MB; nothing to keep)
cat > "$cfg/kwalletrc" <<'EOF'
[Wallet]
Enabled=false
First Use=false
EOF
chown "$LIVE_USER:$LIVE_USER" "$cfg/kscreenlockerrc" "$cfg/baloofilerc" "$cfg/kwalletrc"

# "Install TwilightOS" icon on the live desktop
install -d -o "$LIVE_USER" -g "$LIVE_USER" "/home/$LIVE_USER/Desktop"
install -m755 -o "$LIVE_USER" -g "$LIVE_USER" /usr/share/applications/org.twilightos.setup.desktop "/home/$LIVE_USER/Desktop/install-twilightos.desktop"
