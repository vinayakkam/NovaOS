#!/bin/sh
# Test aid: write a memory snapshot of the live session to the first serial port.
# Only runs inside VirtualBox (see twilightos-memreport.service); scripts/test-vm.ps1
# connects that port to a file on the host.
out=/dev/ttyS0
[ -w "$out" ] || exit 0
{
    echo "=== TWILIGHTOS-MEMREPORT $(date -Is) uptime=$(cut -d' ' -f1 /proc/uptime)s ==="
    free -m
    echo "--- /proc/meminfo ---"
    grep -E '^(MemTotal|MemAvailable|Shmem|Cached|Buffers|SwapTotal|SwapFree|AnonPages)' /proc/meminfo
    echo "--- top 15 by RSS (MB) ---"
    ps -eo rss=,comm= --sort=-rss | head -n 15 | awk '{printf "%7.1f  %s\n", $1/1024, $2}'
    echo "--- graphical session ---"
    loginctl list-sessions --no-legend 2>/dev/null
    echo "=== END ==="
} > "$out" 2>&1
