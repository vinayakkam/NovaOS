#!/bin/sh
# TwilightOS Settings backend. One small command per action; read commands print
# key=value lines, list commands print one item per line. Runs as the user.
cmd=$1
[ $# -gt 0 ] && shift

strip_ansi() { sed 's/\x1b\[[0-9;]*m//g'; }

case "$cmd" in
sysinfo)
    echo "product=TwilightOS"
    echo "version=$(cat /usr/share/twilightos/version 2>/dev/null || echo 0.1)"
    echo "hostname=$(cat /etc/hostname 2>/dev/null || uname -n)"
    echo "kernel=$(uname -r)"
    echo "cpu=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ *//')"
    echo "cores=$(nproc)"
    echo "ram=$(awk '/MemTotal/{printf "%.1f GB", $2/1048576}' /proc/meminfo)"
    echo "disk=$(df -h / | awk 'NR==2{print $3" used of "$2}')"
    echo "gpu=$(lspci 2>/dev/null | grep -m1 -iE 'vga|3d|display' | cut -d: -f3- | sed 's/^ *//')"
    echo "uptime=$(uptime -p | sed 's/^up //')"
    echo "plasma=$(plasmashell --version 2>/dev/null | awk '{print $2}')"
    ;;
net-status)
    echo "wifi=$(nmcli radio wifi 2>/dev/null)"
    echo "wwan=$(nmcli radio wwan 2>/dev/null)"
    c=$(nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null | grep ':connected:' | head -n1)
    echo "type=$(echo "$c" | cut -d: -f1)"
    echo "connection=$(echo "$c" | cut -d: -f3-)"
    ;;
wifi-list)
    nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list 2>/dev/null | awk -F: '$4 != "" && !seen[$4]++' | head -n 12
    ;;
wifi-set)        nmcli radio wifi "$1" ;;
airplane-set)
    if [ "$1" = on ]; then nmcli radio all off; rfkill block bluetooth 2>/dev/null
    else nmcli radio all on; rfkill unblock bluetooth 2>/dev/null; fi
    ;;
bt-status)
    s=$(bluetoothctl show 2>/dev/null)
    case "$s" in
        *"Powered: yes"*) echo "bt=on" ;;
        *Powered*)        echo "bt=off" ;;
        *)                echo "bt=none" ;;
    esac
    ;;
bt-set)          bluetoothctl power "$1" >/dev/null ;;
bt-devices)      bluetoothctl devices Paired 2>/dev/null | cut -d' ' -f3- ;;
vol-get)
    v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    echo "vol=$(echo "$v" | awk '{printf "%d", $2*100 + 0.5}')"
    case "$v" in *MUTED*) echo "muted=yes" ;; *) echo "muted=no" ;; esac
    echo "sink=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk -F'"' '/node.description/{print $2; exit}')"
    ;;
vol-set)         wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "$1%" ;;
mute-toggle)     wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
display-get)
    o=$(kscreen-doctor -o 2>/dev/null | strip_ansi)
    echo "output=$(echo "$o" | awk '/^Output:/{print $3; exit}')"
    echo "scale=$(echo "$o" | awk '/Scale:/{print $2; exit}')"
    echo "mode=$(echo "$o" | grep -o '[0-9]*x[0-9]*@[0-9.]*\*' | head -n1 | tr -d '*')"
    ;;
scale-set)
    o=$(kscreen-doctor -o 2>/dev/null | strip_ansi | awk '/^Output:/{print $3; exit}')
    [ -n "$o" ] && kscreen-doctor "output.$o.scale.$1"
    ;;
night-get)       echo "night=$(kreadconfig6 --file kwinrc --group NightColor --key Active --default false)" ;;
night-set)
    kwriteconfig6 --file kwinrc --group NightColor --key Active "$1"
    kwriteconfig6 --file kwinrc --group NightColor --key Mode Constant
    kwriteconfig6 --file kwinrc --group NightColor --key NightTemperature 4200
    dbus-send --session --type=method_call --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure
    ;;
theme-get)
    echo "scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme --default Twilight)"
    echo "accent=$(kreadconfig6 --file kdeglobals --group General --key AccentColor)"
    ;;
theme-set)       plasma-apply-colorscheme "$1" >/dev/null ;;           # Twilight | BreezeLight
accent-set)
    # plasma-apply-colorscheme --accent-color is a no-op when the scheme is already
    # active, so store the accent ourselves and re-apply the scheme to recolour apps.
    hex=$(echo "$1" | tr -d '#' | tr 'A-F' 'a-f')
    case "$hex" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *) echo "bad colour" >&2; exit 2 ;; esac
    r=$(printf '%d' "0x$(echo "$hex" | cut -c1-2)")
    g=$(printf '%d' "0x$(echo "$hex" | cut -c3-4)")
    b=$(printf '%d' "0x$(echo "$hex" | cut -c5-6)")
    kwriteconfig6 --file kdeglobals --group General --key AccentColor "$r,$g,$b"
    kwriteconfig6 --file kdeglobals --group General --key accentColorFromWallpaper false
    scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme --default Twilight)
    [ "$scheme" = BreezeDark ] && other=BreezeLight || other=BreezeDark
    plasma-apply-colorscheme "$other" >/dev/null 2>&1
    plasma-apply-colorscheme "$scheme" >/dev/null 2>&1
    ;;
wallpapers)
    for d in /usr/share/wallpapers/*/contents/images; do
        f=$(ls -1 "$d" 2>/dev/null | sort -V | tail -n1)
        [ -n "$f" ] && echo "$d/$f"
    done
    ls -1 "$HOME"/Pictures/*.jpg "$HOME"/Pictures/*.jpeg "$HOME"/Pictures/*.png 2>/dev/null | head -n 12
    ;;
wallpaper-set)   plasma-apply-wallpaperimage "$1" >/dev/null ;;
time-get)
    echo "tz=$(timedatectl show -p Timezone --value 2>/dev/null)"
    echo "ntp=$(timedatectl show -p NTP --value 2>/dev/null)"
    echo "clock24=$(kreadconfig6 --file plasma-localerc --group Formats --key LC_TIME --default en_IN)"
    ;;
power-get)
    if command -v powerprofilesctl >/dev/null; then echo "profile=$(powerprofilesctl get)"; else echo "profile=none"; fi
    b=$(ls /sys/class/power_supply 2>/dev/null | grep -m1 '^BAT')
    [ -n "$b" ] && echo "battery=$(cat /sys/class/power_supply/$b/capacity)%"
    ;;
power-set)       powerprofilesctl set "$1" ;;
open)            setsid -f "$@" >/dev/null 2>&1 ;;
*)
    echo "usage: twilightos-settings-helper <command> [args]" >&2
    exit 2
    ;;
esac
