#!/bin/sh
# TwilightOS Settings backend. One small command per action; read commands print
# key=value lines, list commands print one item per line. Runs as the user.
cmd=$1
[ $# -gt 0 ] && shift

strip_ansi() { sed 's/\x1b\[[0-9;]*m//g'; }

# bluetoothctl waits forever when there is no adapter, so check first and time-box it
has_bt() { ls /sys/class/bluetooth 2>/dev/null | grep -q '^hci'; }
bt_state() {
    has_bt || { echo none; return; }
    case "$(timeout 2 bluetoothctl show 2>/dev/null)" in
        *"Powered: yes"*) echo on ;;
        *Powered*)        echo off ;;
        *)                echo none ;;
    esac
}

case "$cmd" in
sysinfo)
    echo "product=TwilightOS"
    echo "version=$(cat /usr/share/twilightos/version 2>/dev/null || echo 0.1)"
    echo "hostname=$(cat /etc/hostname 2>/dev/null || uname -n)"
    echo "kernel=$(uname -r)"
    echo "cpu=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2- | sed 's/^ *//')"
    echo "cores=$(nproc)"
    echo "ram=$(awk '/MemTotal/{printf "%.1f GB", $2/1048576}' /proc/meminfo)"
    echo "disk=$(df -h / | awk 'NR==2{print $3" used of "$2}')"
    echo "gpu=$(lspci 2>/dev/null | grep -m1 -iE 'vga|3d|display' | cut -d: -f3- | sed 's/^ *//')"
    echo "uptime=$(uptime -p | sed 's/^up //')"
    echo "plasma=$(plasmashell --version 2>/dev/null | awk '{print $2}')"
    ;;
net-status)
    echo "wifi=$(nmcli radio wifi 2>/dev/null)"
    echo "wwan=$(nmcli radio wwan 2>/dev/null)"
    c=$(nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null | grep ':connected:' | head -n1)
    echo "type=$(echo "$c" | cut -d: -f1)"
    echo "connection=$(echo "$c" | cut -d: -f3-)"
    ;;
wifi-list)
    nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list 2>/dev/null | awk -F: '$4 != "" && !seen[$4]++' | head -n 12
    ;;
wifi-set)        nmcli radio wifi "$1" ;;
airplane-set)
    if [ "$1" = on ]; then nmcli radio all off; rfkill block bluetooth 2>/dev/null
    else nmcli radio all on; rfkill unblock bluetooth 2>/dev/null; fi
    ;;
bt-status)       echo "bt=$(bt_state)" ;;
bt-set)          has_bt && timeout 3 bluetoothctl power "$1" >/dev/null ;;
bt-devices)      has_bt && timeout 2 bluetoothctl devices Paired 2>/dev/null | cut -d' ' -f3- ;;
vol-get)
    v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    echo "vol=$(echo "$v" | awk '{printf "%d", $2*100 + 0.5}')"
    case "$v" in *MUTED*) echo "muted=yes" ;; *) echo "muted=no" ;; esac
    echo "sink=$(wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null | awk -F'"' '/node.description/{print $2; exit}')"
    ;;
vol-set)         wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ "$1%" ;;
mute-toggle)     wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
display-get)
    o=$(kscreen-doctor -o 2>/dev/null | strip_ansi)
    echo "output=$(echo "$o" | awk '/^Output:/{print $3; exit}')"
    echo "scale=$(echo "$o" | awk '/Scale:/{print $2; exit}')"
    echo "mode=$(echo "$o" | grep -o '[0-9]*x[0-9]*@[0-9.]*\*' | head -n1 | tr -d '*')"
    ;;
scale-set)
    o=$(kscreen-doctor -o 2>/dev/null | strip_ansi | awk '/^Output:/{print $3; exit}')
    [ -n "$o" ] && kscreen-doctor "output.$o.scale.$1"
    ;;
night-get)       echo "night=$(kreadconfig6 --file kwinrc --group NightColor --key Active --default false)" ;;
night-set)
    kwriteconfig6 --file kwinrc --group NightColor --key Active "$1"
    kwriteconfig6 --file kwinrc --group NightColor --key Mode Constant
    kwriteconfig6 --file kwinrc --group NightColor --key NightTemperature 4200
    dbus-send --session --type=method_call --dest=org.kde.KWin /KWin org.kde.KWin.reconfigure
    ;;
theme-get)
    echo "scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme --default Twilight)"
    echo "accent=$(kreadconfig6 --file kdeglobals --group General --key AccentColor)"
    ;;
theme-set)       plasma-apply-colorscheme "$1" >/dev/null ;;           # Twilight | BreezeLight
accent-set)
    # plasma-apply-colorscheme --accent-color is a no-op when the scheme is already
    # active, so store the accent ourselves and re-apply the scheme to recolour apps.
    hex=$(echo "$1" | tr -d '#' | tr 'A-F' 'a-f')
    case "$hex" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;; *) echo "bad colour" >&2; exit 2 ;; esac
    r=$(printf '%d' "0x$(echo "$hex" | cut -c1-2)")
    g=$(printf '%d' "0x$(echo "$hex" | cut -c3-4)")
    b=$(printf '%d' "0x$(echo "$hex" | cut -c5-6)")
    kwriteconfig6 --file kdeglobals --group General --key AccentColor "$r,$g,$b"
    kwriteconfig6 --file kdeglobals --group General --key accentColorFromWallpaper false
    scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme --default Twilight)
    [ "$scheme" = BreezeDark ] && other=BreezeLight || other=BreezeDark
    plasma-apply-colorscheme "$other" >/dev/null 2>&1
    plasma-apply-colorscheme "$scheme" >/dev/null 2>&1
    ;;
wallpapers)
    for d in /usr/share/wallpapers/*/contents/images; do
        f=$(ls -1 "$d" 2>/dev/null | sort -V | tail -n1)
        [ -n "$f" ] && echo "$d/$f"
    done
    ls -1 "$HOME"/Pictures/*.jpg "$HOME"/Pictures/*.jpeg "$HOME"/Pictures/*.png 2>/dev/null | head -n 12
    ;;
wallpaper-set)   plasma-apply-wallpaperimage "$1" >/dev/null ;;
time-get)
    echo "tz=$(timedatectl show -p Timezone --value 2>/dev/null)"
    echo "ntp=$(timedatectl show -p NTP --value 2>/dev/null)"
    echo "clock24=$(kreadconfig6 --file plasma-localerc --group Formats --key LC_TIME --default en_IN)"
    ;;
power-get)
    if command -v powerprofilesctl >/dev/null; then echo "profile=$(powerprofilesctl get)"; else echo "profile=none"; fi
    b=$(ls /sys/class/power_supply 2>/dev/null | grep -m1 '^BAT')
    [ -n "$b" ] && echo "battery=$(cat /sys/class/power_supply/$b/capacity)%"
    ;;
power-set)       powerprofilesctl set "$1" ;;
open)            setsid -f "$@" >/dev/null 2>&1 ;;

# ---------------- Quick Settings ----------------
qs-status)
    # everything Quick Settings shows, in one call
    echo "wifi=$(nmcli radio wifi 2>/dev/null)"
    c=$(nmcli -t -f TYPE,STATE,CONNECTION dev 2>/dev/null | grep ':connected:' | head -n1)
    echo "type=$(echo "$c" | cut -d: -f1)"
    echo "conn=$(echo "$c" | cut -d: -f3-)"
    echo "signal=$(nmcli -t -f IN-USE,SIGNAL dev wifi list --rescan no 2>/dev/null | awk -F: '$1=="*"{print $2; exit}')"
    echo "bt=$(bt_state)"
    v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)
    echo "vol=$(echo "$v" | awk '{printf "%d", $2*100 + 0.5}')"
    case "$v" in *MUTED*) echo "muted=yes" ;; *) echo "muted=no" ;; esac
    echo "night=$(kreadconfig6 --file kwinrc --group NightColor --key Active --default false)"
    case "$(kreadconfig6 --file plasmanotifyrc --group DoNotDisturb --key Until)" in 2099*) echo "dnd=on" ;; *) echo "dnd=off" ;; esac
    echo "scheme=$(kreadconfig6 --file kdeglobals --group General --key ColorScheme --default Twilight)"
    command -v brightnessctl >/dev/null && [ -n "$(ls /sys/class/backlight 2>/dev/null)" ] \
        && echo "bright=$(brightnessctl -m 2>/dev/null | cut -d, -f4 | tr -d '%')"
    b=$(ls /sys/class/power_supply 2>/dev/null | grep -m1 '^BAT')
    if [ -n "$b" ]; then
        echo "battery=$(cat /sys/class/power_supply/$b/capacity)"
        echo "charging=$(cat /sys/class/power_supply/$b/status)"
    fi
    ;;
dnd-set)
    # "until 2099" = on until switched off; Plasma watches this file
    if [ "$1" = on ]; then
        kwriteconfig6 --file plasmanotifyrc --group DoNotDisturb --key Until "2099,1,1,0,0,0"
    else
        kwriteconfig6 --file plasmanotifyrc --group DoNotDisturb --key Until --delete
    fi
    ;;
bright-set)      brightnessctl -q set "$1%" ;;
dark-set)
    if [ "$1" = on ]; then plasma-apply-colorscheme Twilight >/dev/null; else plasma-apply-colorscheme BreezeLight >/dev/null; fi
    ;;
mic-get)
    v=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null)
    echo "mic=$(echo "$v" | awk '{printf "%d", $2*100 + 0.5}')"
    case "$v" in *MUTED*) echo "micmuted=yes" ;; *) echo "micmuted=no" ;; esac
    ;;
mic-set)         wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ "$1%" ;;

# ---------------- Privacy & taskbar ----------------
privacy-get)
    echo "locktimeout=$(kreadconfig6 --file kscreenlockerrc --group Daemon --key Timeout --default 5)"
    echo "autolock=$(kreadconfig6 --file kscreenlockerrc --group Daemon --key Autolock --default true)"
    echo "indexing=$(kreadconfig6 --file baloofilerc --group 'Basic Settings' --key Indexing-Enabled --default false)"
    echo "recent=$(kreadconfig6 --file kactivitymanagerd-pluginsrc --group Plugin-org.kde.ActivityManager.Resources.Scoring --key what-to-remember --default 0)"
    ;;
locktimeout-set)
    if [ "$1" = 0 ]; then
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock false
    else
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key Autolock true
        kwriteconfig6 --file kscreenlockerrc --group Daemon --key Timeout "$1"
    fi
    ;;
indexing-set)
    if [ "$1" = on ]; then balooctl6 enable >/dev/null 2>&1; else balooctl6 disable >/dev/null 2>&1; fi
    kwriteconfig6 --file baloofilerc --group 'Basic Settings' --key Indexing-Enabled "$([ "$1" = on ] && echo true || echo false)"
    ;;
recent-set)
    # 0 = remember everything, 2 = remember nothing
    kwriteconfig6 --file kactivitymanagerd-pluginsrc --group Plugin-org.kde.ActivityManager.Resources.Scoring --key what-to-remember "$([ "$1" = on ] && echo 0 || echo 2)"
    ;;
recent-clear)
    rm -f "$HOME/.local/share/recently-used.xbel" "$HOME"/.local/share/RecentDocuments/*.desktop 2>/dev/null
    qdbus6 org.kde.ActivityManager /ActivityManager/Resources/Scoring DeleteRecentStats "" 0 everything >/dev/null 2>&1 || true
    ;;
storage-get)
    df -h / | awk 'NR==2{print "root_used="$3; print "root_size="$2; print "root_pct="$5}'
    echo "cache=$(du -sh "$HOME/.cache" 2>/dev/null | cut -f1)"
    echo "trash=$(du -sh "$HOME/.local/share/Trash" 2>/dev/null | cut -f1)"
    ;;
storage-clean)
    rm -rf "$HOME/.cache/thumbnails" "$HOME"/.local/share/Trash/files/* "$HOME"/.local/share/Trash/info/* 2>/dev/null
    ;;
panel)
    # TwilightOS layout tweaks, applied live through Plasma's scripting interface.
    #   panel top-floating on|off      panel dock dodge|autohide|always
    case "$1:$2" in
        top-floating:on)  js='panels().forEach(function(p){ if (p.location == "top") p.floating = true; })' ;;
        top-floating:off) js='panels().forEach(function(p){ if (p.location == "top") p.floating = false; })' ;;
        dock:dodge)       js='panels().forEach(function(p){ if (p.location == "bottom") p.hiding = "dodgewindows"; })' ;;
        dock:autohide)    js='panels().forEach(function(p){ if (p.location == "bottom") p.hiding = "autohide"; })' ;;
        dock:always)      js='panels().forEach(function(p){ if (p.location == "bottom") p.hiding = "none"; })' ;;
        *) echo "unknown panel option" >&2; exit 2 ;;
    esac
    dbus-send --session --type=method_call --dest=org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "string:$js"
    ;;
panel-get)
    dbus-send --session --print-reply --type=method_call --dest=org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript \
        'string:var o=[]; panels().forEach(function(p){ if (p.location=="top") o.push("topfloating="+p.floating); if (p.location=="bottom") o.push("dock="+p.hiding); }); print(o.join(";"));' \
        2>/dev/null | sed -n 's/^ *string "\(.*\)"$/\1/p' | tr ';' '\n'
    ;;
*)
    echo "usage: twilightos-settings-helper <command> [args]" >&2
    exit 2
    ;;
esac
