// NovaOS terminal greeting (fastfetch). Shown by /usr/local/bin/novaos-shell.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/novaos/terminal/novaos-logo.txt",
        "color": {
            "1": "38;2;242;104;58",
            "2": "38;2;247;200;106",
            "3": "38;2;243;182;81"
        },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;242;104;58",
            "title": "38;2;243;182;81"
        },
        "key": { "width": 10 }
    },
    "modules": [
        "title",
        { "type": "custom", "format": "\u001b[38;2;114;120;146m──────────────────────────────" },
        { "type": "os", "key": "OS", "format": "NovaOS 0.1 · Arch Linux base" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "de", "key": "Desktop" },
        { "type": "shell", "key": "Shell" },
        { "type": "cpu", "key": "CPU" },
        { "type": "gpu", "key": "GPU" },
        { "type": "memory", "key": "Memory" },
        { "type": "disk", "key": "Disk", "folders": "/" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
