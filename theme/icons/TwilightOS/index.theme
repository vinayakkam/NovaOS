[Icon Theme]
Name=TwilightOS
Comment=TwilightOS Twilight icons (original artwork). Everything else comes from Breeze Dark.
Inherits=breeze-dark,breeze,hicolor
Example=folder
DisplayDepth=32
FollowsColorScheme=true
Directories=scalable/apps,scalable/places,symbolic/actions,symbolic/status,symbolic/categories

[scalable/apps]
Size=48
MinSize=16
MaxSize=512
Context=Applications
Type=Scalable

[scalable/places]
Size=48
MinSize=16
MaxSize=512
Context=Places
Type=Scalable

[symbolic/actions]
Size=22
MinSize=16
MaxSize=128
Context=Actions
Type=Scalable

[symbolic/status]
Size=22
MinSize=16
MaxSize=128
Context=Status
Type=Scalable

[symbolic/categories]
Size=22
MinSize=16
MaxSize=128
Context=Categories
Type=Scalable
