[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX

# macOS-style hot corner: top-left opens Overview (7 = top-left screen edge)
[Effect-overview]
BorderActivate=7

[Desktops]
Number=4
Rows=1

# Memory: blur/contrast keep extra full-screen buffers (in system RAM when there is
# no GPU, e.g. in a VM). Panels stay translucent; turn blur on in Desktop Effects.
[Plugins]
blurEnabled=false
contrastEnabled=false
slidebackEnabled=false
wobblywindowsEnabled=false
magiclampEnabled=false
kwin4_effect_geometry_changeEnabled=false

[Windows]
TitlebarDoubleClickCommand=Maximize
