# NovaOS local package: ONLYOFFICE Desktop Editors, repackaged from the official .deb.
# Built by scripts/build-iso.sh into the build-time [novaos] repo.
pkgname=onlyoffice-bin
pkgver=10.0.0
pkgrel=1
pkgdesc="ONLYOFFICE Desktop Editors: documents, spreadsheets, presentations and PDF (official build)"
arch=('x86_64')
url="https://www.onlyoffice.com/desktop.aspx"
license=('AGPL-3.0-only')
depends=('curl' 'gtk3' 'alsa-lib' 'libpulse' 'nss' 'libxss' 'libxkbcommon-x11'
         'ttf-dejavu' 'ttf-liberation' 'ttf-carlito')
provides=('onlyoffice')
conflicts=('onlyoffice')
options=('!strip' '!debug')
source=("onlyoffice-${pkgver}_amd64.deb::https://github.com/ONLYOFFICE/DesktopEditors/releases/download/v${pkgver}/onlyoffice-desktopeditors_amd64.deb")
sha256sums=('2190edb4022a2ac2f6eee0f78815520f0e4ece1e8a1097c645a6f9b225c8b59c')
noextract=("onlyoffice-${pkgver}_amd64.deb")

package() {
    bsdtar -xf "onlyoffice-${pkgver}_amd64.deb" -C "$srcdir" 'data.tar.*'
    bsdtar -xf "$srcdir"/data.tar.* -C "$pkgdir"
    # Debian-only bits
    rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/lintian" "$pkgdir/etc/apt"
    rmdir "$pkgdir/etc" 2>/dev/null || true
}
